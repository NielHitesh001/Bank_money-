# World Money Terminal OS — Production Environment Configuration
# Target Go-Live: September 8, 2026

ENVIRONMENT=production
NODE_ENV=production
PORT=8766
VITE_PORT=5173

# Broker Execution Configuration
# Mode: "paper" (for pre-flight dry run) -> "live" (for Sept 8 launch)
ALPACA_MODE=paper
ALPACA_KEY=YOUR_ALPACA_LIVE_KEY_HERE
ALPACA_SECRET=YOUR_ALPACA_LIVE_SECRET_HERE
ALPACA_BASE_URL=https://api.alpaca.markets
LIVE_TRADING_ENABLED=true
LIVE_CAPITAL_LIMIT=50000

# Macro Data Feed
FRED_API_KEY=your_fred_api_key_here

# Risk Guardrails & Circuit Breaker Thresholds
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS_LIMIT=-5000
MAX_PORTFOLIO_LEVERAGE=1.0
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Regulatory Compliance & Audit Retention
AUDIT_LOG_RETENTION_DAYS=2555
LOG_LEVEL=info
